node_modules/
dist/
# tipos gerados pelo Astro na landing
apps/landing/.astro/
coverage/
*.tsbuildinfo

# segredos locais: nunca versionar
.env
.env.*
!.env.example
.secrets/

# Uploads do StorageProvider local (driver disk): fotos de clientes NUNCA vão
# para o git. São duas linhas ancoradas em vez de um "storage/" solto porque:
#  - sem a barra inicial, o padrão casaria também com o CÓDIGO-FONTE em
#    apps/api/src/integrations/storage;
#  - a API roda com cwd=apps/api, então a pasta de uploads nasce lá, e não na
#    raiz (foi assim que quatro fotos de teste entraram no commit 208173b).
/storage/
/apps/api/storage/

# Playwright: relatórios, rastros e as capturas de conferência não são código
/test-results/
/playwright-report/
/blob-report/
/e2e/screenshots/
.last-run.json

.DS_Store
Thumbs.db
*.log
