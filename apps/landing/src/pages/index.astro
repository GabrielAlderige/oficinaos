      aria-label="Falar no WhatsApp"
    >
      <svg viewBox="0 0 24 24" class="size-7 fill-current" aria-hidden="true">
        <path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm0 18a8 8 0 01-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1112 20zm4.4-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.6 6.6 0 01-3.2-2.8c-.1-.2 0-.4.1-.5l.4-.5.2-.4v-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a1 1 0 00-.7.3A2.9 2.9 0 006 8.9c0 1.7 1.2 3.3 1.4 3.5a11 11 0 004.3 3.8c1.6.6 2 .5 2.4.5.5 0 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.4-.2z" />
      </svg>
    </a>

    <script is:inline>
      (function () {
        var semAnimacao = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* aparece ao rolar. Sem animação pedida, tudo já nasce visível. */
        var alvos = document.querySelectorAll('.reveal');
        if (semAnimacao || !('IntersectionObserver' in window)) {
          alvos.forEach(function (el) { el.classList.add('visivel'); });
        } else {
          var obs = new IntersectionObserver(
            function (entradas) {
              entradas.forEach(function (e) {
                if (e.isIntersecting) { e.target.classList.add('visivel'); obs.unobserve(e.target); }
              });
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
          );
          alvos.forEach(function (el) { obs.observe(el); });
        }

        /* os números contam ao entrar na tela */
        document.querySelectorAll('.conta').forEach(function (el) {
          var ate = Number(el.dataset.ate || 0);
          if (semAnimacao || !('IntersectionObserver' in window)) {
            el.textContent = ate.toLocaleString('pt-BR');
            return;
          }
          var o = new IntersectionObserver(function (entradas) {
            if (!entradas[0].isIntersecting) return;
            o.disconnect();
            var inicio = performance.now();
            (function passo(agora) {
              var t = Math.min((agora - inicio) / 1100, 1);
              var suave = 1 - Math.pow(1 - t, 3);
              el.textContent = Math.round(ate * suave).toLocaleString('pt-BR');
              if (t < 1) requestAnimationFrame(passo);
            })(inicio);
          }, { threshold: 0.4 });
          o.observe(el);
        });

        /* máscara do telefone, enquanto digita */
        var campoTel = document.querySelector('input[name="phone"]');
        if (campoTel) {
          campoTel.addEventListener('input', function () {
            var d = campoTel.value.replace(/\D/g, '').slice(0, 11);
            campoTel.value =
              d.length <= 2 ? d
              : d.length <= 6 ? '(' + d.slice(0, 2) + ') ' + d.slice(2)
              : d.length <= 10 ? '(' + d.slice(0, 2) + ') ' + d.slice(2, 6) + '-' + d.slice(6)
              : '(' + d.slice(0, 2) + ') ' + d.slice(2, 7) + '-' + d.slice(7);
          });
        }

        /* o formulário grava no banco e leva para o WhatsApp */
        var form = document.getElementById('form-interesse');
        var aviso = document.getElementById('form-aviso');
        if (form) {
          form.addEventListener('submit', async function (evento) {
            evento.preventDefault();
            var botao = form.querySelector('button[type="submit"]');
            var dados = Object.fromEntries(new FormData(form).entries());

            if (!dados.name || String(dados.name).trim().length < 2) {
              aviso.textContent = 'Diga seu nome para a gente saber como te chamar.';
              aviso.className = 'text-sm text-accent';
              return;
            }
            if (String(dados.phone).replace(/\D/g, '').length < 10) {
              aviso.textContent = 'Informe o WhatsApp com DDD.';
              aviso.className = 'text-sm text-accent';
              return;
            }

            botao.disabled = true;
            botao.textContent = 'Enviando…';
            aviso.textContent = '';
            try {
              var r = await fetch('/api/v1/prospects', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify(dados),
              });
              if (!r.ok) throw new Error('falhou');
              form.innerHTML =
                '<div class="py-6 text-center">' +
                '<p class="text-4xl">✅</p>' +
                '<p class="mt-3 text-lg font-semibold">Recebemos seu contato</p>' +
                '<p class="mt-2 text-sm text-muted">A gente chama no WhatsApp. Se preferir adiantar, fale agora:</p>' +
                '<a class="mt-5 inline-flex items-center gap-2 rounded-md bg-[#25D366] px-6 py-3 text-sm font-medium text-white" ' +
                'href="' + document.querySelector('a[href*="wa.me"]').getAttribute('href') + '" target="_blank" rel="noopener">' +
                'Chamar no WhatsApp</a></div>';
            } catch (erro) {
              aviso.textContent = 'Não consegui enviar agora. Chama a gente no WhatsApp que resolvemos na hora.';
              aviso.className = 'text-sm text-accent';
              botao.disabled = false;
              botao.textContent = 'Quero ver funcionando';
            }
          });
        }
      })();
    </script>
