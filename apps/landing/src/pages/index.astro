---
import '../styles/landing.css';

/**
 * A landing do OficinaOS (E42).
 *
 * Regras que valem aqui tanto quanto no produto: **nada de dado fictício
 * apresentado como real**. Não há depoimento inventado, logo de cliente que
 * não existe, número de oficinas atendidas nem "economize 30% do seu tempo".
 * Os números desta página saem do banco de verdade (as fichas de carro) ou da
 * tabela de planos. O que a página promete é exatamente o que o sistema faz
 * hoje — e o que ainda não faz está escrito, na seção de perguntas.
 *
 * A seção de prova social é um CONVITE, não um depoimento: enquanto não
 * houver cliente de verdade para citar com nome e autorização, citar qualquer
 * coisa seria inventar.
 */
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'https://app.oficinaos.com.br';

/** Comercial: o número oficial do OficinaOS, (35) 99755-8675. */
const WHATSAPP = '5535997558675';
const zap = (texto: string) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(texto)}`;

const dores = [
  {
    titulo: 'O orçamento some na conversa',
    texto:
      'Você manda por áudio, o cliente some, volta três dias depois perguntando "quanto era mesmo?". E ninguém sabe o que foi combinado.',
  },
  {
    titulo: 'A entrega vira discussão',
    texto:
      'O risco no para-choque já estava lá? O cliente jura que não. Sem foto da entrada, quem perde é sempre a oficina.',
  },
  {
    titulo: 'O caderno não fecha o mês',
    texto:
      'Quanto entrou, quanto falta receber, quanto o mecânico ganhou de comissão. Descobrir isso leva um domingo inteiro.',
  },
];

const passos = [
  {
    numero: '01',
    titulo: 'O carro chega',
    texto:
      'Busque pela placa — antiga ou Mercosul, tanto faz. Abra a OS e faça o check-in com fotos do estado do veículo.',
    detalhe: 'Seis toques, do balcão.',
  },
  {
    numero: '02',
    titulo: 'Você monta o orçamento',
    texto:
      'Serviços e peças do seu catálogo, com o total recalculando ao vivo. Marque o que é necessário e o que é recomendado.',
    detalhe: 'Anexe a foto da peça gasta: ela vende sozinha.',
  },
  {
    numero: '03',
    titulo: 'O cliente aprova pelo celular',
    texto:
      'Um link pelo WhatsApp. Ele vê as fotos, aprova item a item e confirma. A OS muda para aprovada sozinha e a peça já fica reservada.',
    detalhe: 'Sem login, sem app, sem ligar para ninguém.',
  },
  {
    numero: '04',
    titulo: 'Você executa e entrega',
    texto:
      'Baixa de estoque na finalização, aviso de "veículo pronto" no WhatsApp, pagamento no Pix e assinatura na tela.',
    detalhe: 'Com foto da saída, se você quiser.',
  },
];

/** Só o que TEM tela hoje. Fornecedores e compras ficaram para depois. */
const modulos = [
  { titulo: 'Ordem de serviço', texto: 'Check-in com fotos, itens com total ao vivo, trilha do próximo passo e impressão.' },
  { titulo: 'Orçamento por link', texto: 'Aprovação parcial, prova de quem autorizou, orçamento complementar.' },
  { titulo: 'Agenda', texto: 'Dia, semana e mês, uma coluna por mecânico, aviso de conflito e check-in que abre a OS.' },
  { titulo: 'Estoque', texto: 'Custo médio, reserva na aprovação, baixa na finalização e alerta de mínimo.' },
  { titulo: 'Ficha do carro', texto: 'Óleo, torque, fluido e pneu — com a página do manual de onde o valor saiu.' },
  { titulo: 'Financeiro', texto: 'A receber, fluxo de caixa, despesas do mês e lucro estimado.' },
  { titulo: 'Pix na hora', texto: 'QR Code com o valor já dentro. Cai direto na sua conta, sem intermediário e sem taxa nossa.' },
  { titulo: 'Comissão', texto: 'Percentual por oficina, por mecânico ou por serviço. Ganha conforme o cliente paga.' },
  { titulo: 'Relatórios', texto: 'Faturamento, lucro, peças e mecânicos — com planilha que abre no Excel em português.' },
  { titulo: 'Pós-venda', texto: 'A fila de quem chamar hoje, com a mensagem pronta. Avaliação no Google depois da entrega.' },
  { titulo: 'No celular', texto: 'O mecânico instala e vê só os carros dele, com cronômetro. Sem ver valor nenhum.' },
  { titulo: 'Nota de serviço', texto: 'Monta a nota com o ISS por dentro. Hoje em simulação — veja as perguntas.' },
];

const planos = [
  {
    code: 'TURBO',
    nome: 'Turbo',
    mensal: 149,
    anual: 1490,
    para: 'A oficina de até 3 pessoas',
    inclui: [
      'Ordem de serviço e check-in com fotos',
      'Orçamento por link, aprovado no celular',
      'Agenda e estoque com custo médio',
      'Financeiro: a receber e fluxo de caixa',
      'Pix na hora e assinatura na entrega',
      'Ficha do carro e app no celular',
    ],
    limites: '3 usuários · 150 OS por mês · 5 GB',
  },
  {
    code: 'SUPERCHARGER',
    nome: 'Supercharger',
    mensal: 279,
    anual: 2790,
    para: 'Quem quer entender a oficina',
    destaque: true,
    inclui: [
      'Tudo do Turbo',
      'Comissão do mecânico',
      'Relatórios e exportação',
      'Pacotes de serviço',
    ],
    limites: '8 usuários · OS ilimitada · 25 GB',
  },
  {
    code: 'NITRO',
    nome: 'Nitro',
    mensal: 499,
    anual: 4990,
    para: 'Quem quer o sistema trabalhando sozinho',
    inclui: [
      'Tudo do Supercharger',
      'Pesquisa de peças pelo carro da OS',
      'WhatsApp oficial, com as respostas na tela',
      'Automações diárias',
    ],
    limites: 'Usuários ilimitados · 100 GB',
  },
];

const perguntas = [
  {
    q: 'Precisa instalar alguma coisa?',
    a: 'Não. Funciona no navegador do computador e do celular. O mecânico adiciona à tela inicial do telefone dele e usa como aplicativo, sem baixar nada de loja nenhuma.',
  },
  {
    q: 'Emite nota fiscal?',
    a: 'Ainda não de verdade. O sistema monta a nota do serviço e mostra o ISS por dentro, mas **não envia para a prefeitura** — e a tela avisa isso em cima de cada nota. Está no plano, por emissor terceirizado. Se emitir nota é o seu problema número um, é melhor você saber agora.',
  },
  {
    q: 'E o WhatsApp, é automático?',
    a: 'Sem configurar nada, o sistema escreve a mensagem e abre a conversa — quem aperta enviar é você, do seu número. Quem assina o Nitro conecta a conta oficial da Meta e aí as respostas do cliente chegam dentro do sistema. Nunca usamos biblioteca não oficial: é o que mantém o número da oficina seguro.',
  },
  {
    q: 'Meus mecânicos vão ver quanto a peça custou?',
    a: 'Não. O papel Mecânico não recebe custo nem financeiro — e isso é decidido no servidor, não escondido na tela. São seis papéis: dono, administrador, gerente, atendente, mecânico e financeiro.',
  },
  {
    q: 'Meus dados ficam presos aí?',
    a: 'Não. Relatórios, clientes e financeiro saem em planilha a qualquer momento. E se você atrasar o pagamento, o sistema trava a escrita mas **nunca a leitura**: seus dados continuam visíveis e exportáveis.',
  },
  {
    q: 'Quanto tempo para começar a usar?',
    a: 'A conta nasce em cinco campos. Nas primeiras oficinas, a gente vai até lá e monta junto com você em uma hora: seus serviços, sua hora técnica e o app no celular de cada mecânico.',
  },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OficinaOS — o cliente aprova o orçamento pelo celular</title>
    <meta
      name="description"
      content="Sistema para oficina mecânica: ordem de serviço com fotos, orçamento que o cliente aprova pelo WhatsApp, estoque, financeiro e a ficha do carro com óleo e torque de 304 modelos."
    />
    <meta name="theme-color" content="#0d0c0e" />
    <link rel="canonical" href="https://oficinaos.com.br/" />
    <meta property="og:title" content="OficinaOS — o cliente aprova o orçamento pelo celular" />
    <meta
      property="og:description"
      content="Do check-in com foto à entrega assinada. O orçamento vai por link e volta aprovado, sem ninguém ligar para ninguém."
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
  </head>

  <body>
    <a class="sr-only focus:not-sr-only focus:absolute focus:m-3 focus:rounded focus:bg-surface focus:px-4 focus:py-2" href="#conteudo">
      Pular para o conteúdo
    </a>

    <header class="sticky top-0 z-40 border-b border-border/70 bg-background/85 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3.5">
        <span class="flex items-center gap-2 text-lg font-semibold tracking-tight">
          <svg viewBox="0 0 32 32" class="size-7" aria-hidden="true">
            <circle cx="16" cy="16" r="14" fill="var(--accent)" />
            <path d="M16 8v8l5 3" stroke="#fff" stroke-width="2.5" fill="none" stroke-linecap="round" />
          </svg>
          <span>Oficina<span class="text-accent">OS</span></span>
        </span>
        <nav class="hidden items-center gap-6 text-sm text-muted md:flex" aria-label="Seções">
          <a class="hover:text-foreground" href="#como-funciona">Como funciona</a>
          <a class="hover:text-foreground" href="#recursos">Recursos</a>
          <a class="hover:text-foreground" href="#ficha">Ficha do carro</a>
          <a class="hover:text-foreground" href="#planos">Planos</a>
        </nav>
        <div class="flex items-center gap-2">
          <a class="hidden text-sm font-medium hover:underline sm:block" href={`${APP_URL}/entrar`}>Entrar</a>
          <a
            class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-foreground transition hover:bg-accent-hover"
            href="#quero-ver"
          >
            Quero ver
          </a>
        </div>
      </div>
    </header>

    <main id="conteudo">
      <!-- ============== HERO ============== -->
      <section class="hero-fundo relative overflow-hidden">
        <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-14 lg:grid-cols-[1.05fr_.95fr] lg:py-20">
          <div class="reveal">
            <p class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent-soft px-3 py-1 text-xs font-medium text-accent">
              <span class="pulso inline-block size-1.5 rounded-full bg-accent"></span>
              14 dias grátis, sem cartão
            </p>
            <h1 class="mt-5 text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl lg:text-[3.4rem]">
              O cliente aprova o orçamento <span class="sublinhado">pelo celular</span>.
              Você nem precisa ligar.
            </h1>
            <p class="mt-5 max-w-xl text-lg text-muted">
              Do check-in com foto à entrega assinada. O orçamento sai por WhatsApp,
              o cliente aprova item a item no telefone dele, e a ordem de serviço
              muda sozinha na sua tela.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a
                class="rounded-md bg-accent px-6 py-3.5 text-sm font-medium text-accent-foreground shadow-sm transition hover:-translate-y-0.5 hover:bg-accent-hover hover:shadow-md"
                href={`${APP_URL}/criar-conta`}
              >
                Testar 14 dias grátis
              </a>
              <a
                class="flex items-center gap-2 rounded-md border border-border bg-surface px-6 py-3.5 text-sm font-medium transition hover:-translate-y-0.5 hover:bg-surface-muted"
                href={zap('Oi! Vi o OficinaOS no site e queria entender como funciona na minha oficina.')}
                target="_blank"
                rel="noopener"
              >
                <svg viewBox="0 0 24 24" class="size-4 fill-[#25D366]" aria-hidden="true">
                  <path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm0 18a8 8 0 01-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1112 20zm4.4-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.6 6.6 0 01-3.2-2.8c-.1-.2 0-.4.1-.5l.4-.5.2-.4v-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a1 1 0 00-.7.3A2.9 2.9 0 006 8.9c0 1.7 1.2 3.3 1.4 3.5a11 11 0 004.3 3.8c1.6.6 2 .5 2.4.5.5 0 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.4-.2z" />
                </svg>
                Falar no WhatsApp
              </a>
            </div>
            <p class="mt-3 text-sm text-muted">
              Sem instalar nada. Funciona no celular do mecânico e no computador do balcão.
            </p>
          </div>

          <!-- celular animado: o momento que vende -->
          <div class="reveal flutua justify-self-center" style="--atraso:.15s">
            <div class="celular">
              <div class="celular-tela">
                <div class="zap-topo">
                  <span class="size-6 rounded-full bg-accent"></span>
                  <span class="text-[11px] font-medium">Auto Center do Marcos</span>
                </div>
                <div class="zap-corpo">
                  <div class="balao" style="--i:0">
                    Seu orçamento do Corolla ABC-1D23 está pronto 👇
                  </div>
                  <div class="balao link" style="--i:1">
                    oficinaos.com.br/orcamento/…
                  </div>
                  <div class="cartao-orcamento" style="--i:2">
                    <p class="text-[10px] tracking-wide text-muted uppercase">Necessário</p>
                    <label class="item"><span class="caixa marcada"></span> Pastilha de freio dianteira <b>R$ 280</b></label>
                    <label class="item"><span class="caixa marcada"></span> Mão de obra — 1,5 h <b>R$ 180</b></label>
                    <p class="mt-2 text-[10px] tracking-wide text-muted uppercase">Recomendado</p>
                    <label class="item apagado"><span class="caixa"></span> Troca de óleo <b>R$ 190</b></label>
                    <div class="total"><span>Total aprovado</span><b>R$ 460</b></div>
                    <div class="botao-aprovar">Aprovar orçamento</div>
                  </div>
                  <div class="balao meu" style="--i:3">Aprovado ✓</div>
                </div>
              </div>
            </div>
            <p class="mt-3 max-w-xs text-center text-xs text-muted">
              É isto que chega no celular do cliente. Ele desmarca o que não quer e aprova só o necessário.
            </p>
          </div>
        </div>
      </section>

      <!-- ============== DORES ============== -->
      <section class="border-y border-border bg-surface">
        <div class="mx-auto max-w-6xl px-5 py-14">
          <h2 class="reveal max-w-2xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
            Toda oficina perde dinheiro nos mesmos três lugares
          </h2>
          <div class="mt-9 grid gap-6 sm:grid-cols-3">
            {
              dores.map((dor, i) => (
                <div class="reveal rounded-xl border border-border bg-background p-5" style={`--atraso:${i * 0.08}s`}>
                  <span class="block h-1 w-9 rounded-full bg-accent"></span>
                  <h3 class="mt-4 font-semibold">{dor.titulo}</h3>
                  <p class="mt-2 text-sm text-muted">{dor.texto}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ============== COMO FUNCIONA ============== -->
      <section id="como-funciona" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-16">
        <h2 class="reveal max-w-2xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
          O dia inteiro da oficina, em quatro passos
        </h2>
        <p class="reveal mt-3 max-w-2xl text-muted">
          Não é um módulo aqui e outro ali. É um caminho só, do carro entrando até o dinheiro entrando.
        </p>
        <ol class="mt-10 grid gap-5 md:grid-cols-2">
          {
            passos.map((passo, i) => (
              <li
                class="reveal relative rounded-xl border border-border bg-surface p-6 transition hover:-translate-y-1 hover:shadow-md"
                style={`--atraso:${i * 0.08}s`}
              >
                <span class="font-mono text-sm font-semibold text-accent">{passo.numero}</span>
                <h3 class="mt-2 text-lg font-semibold">{passo.titulo}</h3>
                <p class="mt-2 text-sm text-muted">{passo.texto}</p>
                <p class="mt-3 text-sm font-medium text-accent">{passo.detalhe}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- ============== NÚMEROS REAIS ============== -->
      <section class="numeros border-y border-border">
        <div class="mx-auto grid max-w-6xl gap-8 px-5 py-14 sm:grid-cols-3">
          <div class="reveal">
            <p class="text-4xl font-semibold tabular-nums text-accent"><span class="conta" data-ate="304">0</span></p>
            <p class="mt-1 text-sm text-muted">fichas de carro prontas, de 11 marcas</p>
          </div>
          <div class="reveal" style="--atraso:.1s">
            <p class="text-4xl font-semibold tabular-nums text-accent"><span class="conta" data-ate="1905">0</span></p>
            <p class="mt-1 text-sm text-muted">especificações conferidas contra o manual do fabricante</p>
          </div>
          <div class="reveal" style="--atraso:.2s">
            <p class="text-4xl font-semibold tabular-nums text-accent"><span class="conta" data-ate="6">0</span></p>
            <p class="mt-1 text-sm text-muted">papéis de acesso, aplicados no servidor</p>
          </div>
        </div>
      </section>

      <!-- ============== FICHA DO CARRO ============== -->
      <section id="ficha" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-16">
        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div class="reveal">
            <p class="text-xs font-semibold tracking-widest text-accent uppercase">Ficha do carro</p>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
              Qual óleo vai nesse carro? E o torque da roda?
            </h2>
            <p class="mt-4 text-muted">
              Digite o modelo e o ano. O sistema mostra óleo e quantidade, fluido de freio,
              aditivo, medida do pneu e torque — e, embaixo de cada valor,{' '}
              <strong class="text-foreground">de qual manual e de qual página aquilo saiu</strong>.
            </p>
            <p class="mt-3 text-muted">
              Não é chute de fórum. São 1.938 especificações lidas dos manuais dos
              fabricantes. Quando não há fonte, a ficha diz “confira antes de aplicar”
              em vez de inventar um número.
            </p>
            <p class="mt-4 text-sm text-muted">
              Está em todos os planos, inclusive no Turbo — e abre de dentro da ordem de serviço.
            </p>
          </div>
          <div class="reveal rounded-xl border border-border bg-surface p-5 shadow-sm" style="--atraso:.12s">
            <div class="flex items-center gap-2 rounded-md border border-border bg-background px-3 py-2 text-sm text-muted">
              <svg viewBox="0 0 24 24" class="size-4 stroke-current" fill="none" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" stroke-linecap="round" />
              </svg>
              <span class="digitando">Corolla 2015</span>
            </div>
            <dl class="mt-4 divide-y divide-border text-sm">
              <div class="flex items-baseline justify-between gap-4 py-2.5">
                <dt class="text-muted">Óleo do motor</dt>
                <dd class="text-right"><b>0W-20 sintético</b><br /><span class="text-xs text-muted">4,2 L com filtro</span></dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 py-2.5">
                <dt class="text-muted">Torque da roda</dt>
                <dd class="text-right"><b>103 N·m</b><br /><span class="text-xs text-muted">manual do proprietário, pág. 402</span></dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 py-2.5">
                <dt class="text-muted">Fluido de freio</dt>
                <dd class="text-right"><b>DOT 3</b><br /><span class="text-xs text-muted">troca a cada 2 anos</span></dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 py-2.5">
                <dt class="text-muted">Pneu</dt>
                <dd class="text-right"><b>195/65 R15</b><br /><span class="text-xs text-muted">32 psi</span></dd>
              </div>
            </dl>
            <p class="mt-3 text-xs text-muted">Exemplo de ficha real do catálogo.</p>
          </div>
        </div>
      </section>

      <!-- ============== RECURSOS ============== -->
      <section id="recursos" class="border-y border-border bg-surface scroll-mt-20">
        <div class="mx-auto max-w-6xl px-5 py-16">
          <h2 class="reveal max-w-2xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
            O que já está funcionando
          </h2>
          <p class="reveal mt-3 max-w-2xl text-muted">
            Tudo o que está nesta lista tem tela e você usa hoje. O que ainda não existe
            está nas perguntas, escrito.
          </p>
          <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              modulos.map((modulo, i) => (
                <div
                  class="reveal rounded-lg border border-border bg-background p-4 transition hover:border-accent/40"
                  style={`--atraso:${(i % 3) * 0.06}s`}
                >
                  <h3 class="text-sm font-semibold">{modulo.titulo}</h3>
                  <p class="mt-1.5 text-sm text-muted">{modulo.texto}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ============== MECÂNICO NO CELULAR ============== -->
      <section class="mx-auto max-w-6xl px-5 py-16">
        <div class="reveal rounded-2xl border border-border bg-gradient-to-br from-accent-soft to-surface p-8 sm:p-12">
          <div class="grid items-center gap-8 lg:grid-cols-[1.1fr_.9fr]">
            <div>
              <p class="text-xs font-semibold tracking-widest text-accent uppercase">No celular do mecânico</p>
              <h2 class="mt-3 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
                Ele abre e já vê só os carros dele
              </h2>
              <p class="mt-4 text-muted">
                Um botão por carro, cronômetro no topo, foto direto da câmera.
