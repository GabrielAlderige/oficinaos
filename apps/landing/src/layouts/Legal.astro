---
import '../styles/landing.css';
import { RESPONSAVEL, VIGENCIA } from '../lib/responsavel';

interface Props {
  titulo: string;
  descricao: string;
}
const { titulo, descricao } = Astro.props;
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'https://app.oficinaosbr.cloud';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · OficinaOS</title>
    <meta name="description" content={descricao} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  </head>
  <body class="bg-background text-foreground antialiased">
    <header class="border-b border-border/70">
      <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-3.5">
        <a href="/" class="flex items-center gap-2 text-lg font-semibold tracking-tight">
          <svg viewBox="0 0 32 32" class="size-7" aria-hidden="true">
            <circle cx="16" cy="16" r="14" fill="var(--accent)" />
            <path d="M16 8v8l5 3" stroke="#fff" stroke-width="2.5" fill="none" stroke-linecap="round" />
          </svg>
          <span>Oficina<span class="text-accent">OS</span></span>
        </a>
        <a class="text-sm font-medium hover:underline" href={`${APP_URL}/entrar`}>Entrar</a>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-5 py-12">
      <h1 class="text-3xl font-semibold tracking-tight text-balance">{titulo}</h1>
      <p class="mt-2 text-sm text-muted">Versão em vigor desde {VIGENCIA}.</p>
      <article class="legal mt-10">
        <slot />
      </article>
    </main>

    <footer class="border-t border-border">
      <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 px-5 py-8 text-sm text-muted">
        <span>© {new Date().getFullYear()} OficinaOS · {RESPONSAVEL.nome}</span>
        <div class="flex flex-wrap gap-5">
          <a class="hover:text-foreground" href="/termos">Termos de uso</a>
          <a class="hover:text-foreground" href="/privacidade">Privacidade</a>
          <a class="hover:text-foreground" href="/">Início</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .legal { line-height: 1.7; max-width: 68ch; }
  .legal h2 { margin-top: 2.5rem; font-size: 1.25rem; font-weight: 600; letter-spacing: -0.01em; }
  .legal h3 { margin-top: 1.5rem; font-weight: 600; }
  .legal p, .legal ul, .legal ol { margin-top: 0.75rem; }
  .legal ul { list-style: disc; padding-left: 1.25rem; }
  .legal ol { list-style: decimal; padding-left: 1.25rem; }
  .legal li + li { margin-top: 0.35rem; }
  .legal a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .legal strong { font-weight: 600; }
  .legal table { width: 100%; margin-top: 1rem; border-collapse: collapse; font-size: 0.875rem; }
  .legal th, .legal td { border-top: 1px solid var(--border); padding: 0.5rem 0.5rem 0.5rem 0; text-align: left; vertical-align: top; }
  .legal .tabela { overflow-x: auto; }
</style>
