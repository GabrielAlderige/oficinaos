# ---------------------------------------------------------------------------
# Produção. Copie para `.env` NO SERVIDOR (fora do git) e preencha.
#
#   cp deploy/.env.example .env
#   chmod 600 .env
#
# As três senhas e o segredo do token devem ser gerados, nunca escolhidos:
#   openssl rand -base64 36     (senhas do banco)
#   openssl rand -base64 48     (JWT_SECRET)
# ---------------------------------------------------------------------------

# --- domínios ---------------------------------------------------------------
# onde o painel atende (é também o que vai nos links enviados ao cliente)
APP_DOMAIN=app.oficinaosbr.cloud
APP_URL=https://app.oficinaosbr.cloud
# a landing; deixe vazio para não publicá-la
LANDING_DOMAIN=oficinaosbr.cloud
# para onde o Let's Encrypt avisa que o certificado vai vencer
ACME_EMAIL=troque-pelo-seu-email@exemplo.com

# --- banco ------------------------------------------------------------------
# superusuário do Postgres do compose (usado só para preparar o banco)
POSTGRES_PASSWORD=
# a role que a API usa no dia a dia (não ignora o RLS)
APP_DB_PASSWORD=
# a dona das tabelas, que roda as migrations
OWNER_DB_PASSWORD=

# --- sessão -----------------------------------------------------------------
# assina o token de acesso; trocar isto desloga todo mundo
JWT_SECRET=

# --- e-mail -----------------------------------------------------------------
# `console` imprime no log; `smtp` envia de verdade
EMAIL_DRIVER=smtp
SMTP_URL=smtp://usuario:senha@smtp.provedor.com:587
EMAIL_FROM=OficinaOS <nao-responda@oficinaosbr.cloud>

# --- termos de uso e privacidade --------------------------------------------
# Quem responde pelo serviço nas páginas /termos e /privacidade. Só números:
# CPF (11) enquanto for pessoa física, CNPJ (14) quando virar empresa. Fica
# AQUI, e não no código, porque o repositório é público. Mudou? Rebuild do web.
RESPONSAVEL_DOC=
CONTATO_EMAIL=contato@oficinaosbr.cloud

# --- cobrança e assinatura --------------------------------------------------
# `simulador` não cobra ninguém. Troque para `asaas` quando a conta existir —
# e comece pelo SANDBOX. Este gateway cobra a ASSINATURA das oficinas.
# A chave começa com $: ponha ENTRE ASPAS SIMPLES, senão o Compose a corta.
PAYMENT_GATEWAY=simulador
ASAAS_API_KEY=''
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
# Cobrança da oficina para o cliente DELA (Pix/boleto na OS). `desligado`
# esconde o cartão: com uma conta Asaas só (a do dono do OficinaOS), o dinheiro
# do cliente da oficina cairia nela. Só ligue quando cada oficina tiver conta.
CHARGES_GATEWAY=desligado

# --- nota fiscal ------------------------------------------------------------
# `simulador` não emite documento fiscal nenhum
FISCAL_DRIVER=simulador

# --- WhatsApp oficial -------------------------------------------------------
# cifra o token que cada oficina cola no sistema (AES-256-GCM). Gere com:
#   openssl rand -base64 32
# Sem ela o sistema funciona: as mensagens saem pelo link do WhatsApp. Trocar
# esta chave torna ilegível o que já foi guardado — guarde-a junto do backup.
SECRETS_KEY=

# --- automações -------------------------------------------------------------
# o trabalhador de fundo sobe junto com a API
JOBS_ENABLED=true

# --- operação ---------------------------------------------------------------
LOG_LEVEL=info
# etiqueta da versão publicada (útil para voltar atrás: TAG=2026-09-22)
TAG=latest

# atrás do Caddy (E41): confia no X-Forwarded-For vindo da rede do compose
TRUST_PROXY=uniquelocal
