# ---------------------------------------------------------------------------
# Caddy: TLS automático (Let's Encrypt), painel, páginas públicas e landing.
#
# Dois endereços:
#   app.<dominio>  → painel + /api (mesma origem: sem CORS, cookie funciona)
#   <dominio>      → a landing estática
#
# Os domínios vêm do .env do compose; sem eles, sobe em :80 para testar por IP.
# ---------------------------------------------------------------------------

{
	# e-mail do Let's Encrypt: é para onde vão os avisos de renovação
	email {$ACME_EMAIL:admin@localhost}
}

{$APP_DOMAIN::80} {
	encode zstd gzip

	# a API mora atrás do mesmo endereço do painel: o navegador nunca
	# conversa com outra origem, então não há CORS nem cookie de terceiro
	handle /api/* {
		reverse_proxy api:3333
	}

	# os vídeos do curso (Tutoriais): ficam FORA da imagem, na pasta tutoriais/
	# ao lado do docker-compose, porque não moram no git (163 MB). O Caddy
	# responde com Range, então o vídeo começa a tocar antes de baixar inteiro
	handle_path /tutoriais/* {
		root * /srv/tutoriais
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle {
		root * /srv/painel

		# URLs bonitas das páginas públicas. Cada uma é uma ENTRADA própria do
		# build (ARCHITECTURE §8.2): o cliente no 3G não baixa o painel junto.
		@orcamento path_regexp orcamento ^/orcamento/.+
		rewrite @orcamento /orcamento.html
		@cotacao path_regexp cotacao ^/cotacao/.+
		rewrite @cotacao /cotacao.html
		@acompanhar path_regexp acompanhar ^/acompanhar/.+
		rewrite @acompanhar /acompanhar.html

		# o resto é o painel (SPA): qualquer rota desconhecida cai no index
		try_files {path} /index.html
		file_server
	}

	header {
		# o painel é servido só por HTTPS; um ano, com os subdomínios juntos
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# o painel não é embutível em outro site. O vídeo do curso é a exceção: ele
	# abre num iframe DO PRÓPRIO painel, e o DENY bloquearia até isso
	@naoVideo not path /tutoriais/*
	header @naoVideo X-Frame-Options DENY
	header /tutoriais/* X-Frame-Options SAMEORIGIN

	# o arquivo com hash no nome nunca muda: cache longo, sem revalidar
	@imutavel path /assets/*
	header @imutavel Cache-Control "public, max-age=31536000, immutable"
}

{$LANDING_DOMAIN::8080} {
	encode zstd gzip

	# o formulário de interessados posta em /api/v1/prospects (E42). Servir a
	# API no MESMO domínio da landing evita CORS por completo: o navegador
	# nunca conversa com outra origem, e não é preciso abrir o WEB_ORIGINS da
	# API para o domínio do site.
	handle /api/* {
		reverse_proxy api:3333
	}

	handle {
		root * /srv/site
		try_files {path} {path}/ /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# www.<dominio> → <dominio>: um endereço só para o Google e para o link
# copiado. Sem LANDING_DOMAIN vira www.localhost, que o Caddy não tenta
# certificar na internet.
www.{$LANDING_DOMAIN:localhost} {
	redir https://{$LANDING_DOMAIN:localhost}{uri} permanent
}
