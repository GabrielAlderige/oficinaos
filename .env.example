# Copie para .env e preencha. O .env nunca vai para o git.

NODE_ENV=development
LOG_LEVEL=info

# ---- API ----
API_HOST=127.0.0.1
API_PORT=3333
# origens do painel autorizadas no CORS (separadas por vírgula)
WEB_ORIGINS=http://localhost:5173
# endereço público do painel: base dos links de e-mail (redefinir senha, convite)
APP_URL=http://localhost:5173

# ---- Autenticação ----
# assina o access token (HS256). Pelo menos 32 caracteres aleatórios. Nunca vai para o front.
JWT_SECRET=TROQUE_POR_UM_SEGREDO_ALEATORIO_COM_48_CARACTERES
# console = o e-mail aparece no terminal da API (desenvolvimento)
EMAIL_DRIVER=console

# ---- Anexos e fotos (check-in da OS) ----
# disk = grava em storage/ e a própria API serve o arquivo com URL assinada e de validade curta
STORAGE_DRIVER=disk
STORAGE_DIR=storage
# teto por arquivo, em bytes (10 MB). O painel comprime a foto no aparelho antes de enviar.
UPLOAD_MAX_BYTES=10485760

# ---- PostgreSQL ----
# Superusuário do Postgres local. Usado SÓ por `npm run db:setup`, nunca pela API.
DATABASE_ADMIN_URL=postgres://postgres:SENHA_DO_SUPERUSUARIO@localhost:5432/postgres

# Runtime da API: role sem BYPASSRLS, sujeita ao isolamento por oficina.
DATABASE_URL=postgres://oficinaos_app:TROQUE_ESTA_SENHA@localhost:5432/oficinaos_dev
# Dona das tabelas: roda migrations.
DATABASE_OWNER_URL=postgres://oficinaos_owner:TROQUE_ESTA_OUTRA@localhost:5432/oficinaos_dev

# Banco de teste (mesmas roles, outro banco). Os testes apagam os dados dele.
TEST_DATABASE_URL=postgres://oficinaos_app:TROQUE_ESTA_SENHA@localhost:5432/oficinaos_test
TEST_DATABASE_OWNER_URL=postgres://oficinaos_owner:TROQUE_ESTA_OUTRA@localhost:5432/oficinaos_test
