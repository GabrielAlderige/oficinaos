{
  "name": "oficinaos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @oficinaos/api\" \"npm run dev -w @oficinaos/web\"",
    "build": "npm run build -w @oficinaos/api && npm run build -w @oficinaos/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:setup": "npm run db:setup -w @oficinaos/api",
    "db:generate": "npm run db:generate -w @oficinaos/api",
    "db:migrate": "npm run db:migrate -w @oficinaos/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
